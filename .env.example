SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=quvideo
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=quvideo
DB_PASSWORD=change-me
DB_URL='jdbc:mysql://localhost:3307/quvideo_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true'
MYSQL_ROOT_PASSWORD=change-root-password
FLYWAY_BASELINE_ON_MIGRATE=true
# ===== LLM：对话/推理（Planner/Executor/Critic），任意 OpenAI 兼容服务 =====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_EVALUATION_ENABLED=false
AI_INTERACTIVE_TIMEOUT_MS=180000
# ===== Embedding：语义向量检索（需 OpenAI 兼容 /embeddings 接口）=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# ===== ASR：语音转写（需 OpenAI 兼容 /audio/transcriptions 接口）=====
ASR_API_KEY=
ASR_URL=https://api.siliconflow.cn/v1/audio/transcriptions
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=quvideo
MINIO_SECRET_KEY=change-me-now
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=quvideo
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=video_chunks
YTDLP_PATH=yt-dlp
FFMPEG_DIR=
OCR_COMMAND=tesseract
# 关键帧 OCR 的语言包目录。默认无需设置：Tesseract 会用安装目录自带的 tessdata。
# 但 Windows 安装包只带 eng 与 osd，没有 chi_sim（实测 Tesseract 5.4 在默认目录下
# --list-langs 仅列出这两个），中文画面会被静默识别成空文本——不报错，只是识别不出字。
# 需要中文识别时：把 chi_sim.traineddata 放到一个目录，再取消下一行注释指向它。
# Tesseract 5.x 的语义是指向「存放 *.traineddata 的目录本身」，不是它的上一级目录
# （指向上级时语言名会变成 tessdata/chi_sim，按 -l chi_sim 取不到）。
# 切勿留成空值：实测 TESSDATA_PREFIX= （空串）会让它改去查找一个编译期写死的构建
# 路径，--list-langs 返回 0 个语言，比完全不设置更糟。
#TESSDATA_PREFIX=C:\Users\你的用户名\tessdata
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:15173,http://127.0.0.1:15173
